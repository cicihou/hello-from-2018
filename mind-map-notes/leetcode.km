0","created":1624761641311,"text":"LCS","expandState":"expand","note":"https://www.youtube.com/watch?v=NnD96abizww\nhttps://www.youtube.com/watch?v=sSno9rV8Rhg"},"children":[{"data":{"id":"ccoa7fr1nf40","created":1625800580283,"text":"Longest Common Sequence"},"children":[{"data":{"id":"cce1orvwxs00","created":1624760949334,"text":"583. Delete Operation for Two Strings(跟 1143 一模一样，只是返回 len(a) + len(b) - 2 * lcs)\n1143. Longest Common Subsequence \n\n712. Minimum ASCII Delete Sum for Two Strings(583 + 1143 只不过需要返回的值从长度变成了 ord(str) )"},"children":[]}]},{"data":{"id":"ccoa75mzhxs0","created":1625800558270,"text":"Longest common substring/subarray"},"children":[{"data":{"id":"ccoa742pb8w0","created":1625800554866,"text":"718. Maximum Length of Repeated Subarray"},"children":[]}]}]},{"data":{"id":"cccgsnqtj6g0","created":1624600450510,"text":"198 & 213. House Robber II\n337 House Robber III 对应的结构不再是数组而是树，而且用递归就能完成"},"children":[]},{"data":{"id":"cdjqbiip6s80","created":1628994396180,"text":"312 burst bollons\n488 zuma games\n546 Remove Boxes "},"children":[]}]},{"data":{"id":"cddx4wp8x200","created":1628404266531,"text":"panlindrome","expandState":"expand"},"children":[{"data":{"id":"ce88sf878s00","created":1631483940144,"text":"substring"},"children":[{"data":{"id":"ccbscn7k0200","created":1624531488881,"text":"5. 最长回文子串\n647. Palindromic Substrings"},"children":[]}]},{"data":{"id":"ce88sttovds0","created":1631483971919,"text":"subsequence"},"children":[{"data":{"id":"ce88sz3doe80","created":1631483983389,"text":"516. Longest Palindromic Subsequence\n（两年前做的了，GitHub里面没存这道题，有空需要复习一下）"},"children":[]}]},{"data":{"id":"cddx50dphm00","created":1628404274541,"text":"131 && 132. Palindrome Partitioning II\n1278. Palindrome Partitioning III\n\n131 是backtrack，132 才是 dp（里面包含了在 O(n^2)中判断字符串回文的写法，注意复习）"},"children":[]}]},{"data":{"id":"ccmz339d9ns0","created":1625667647470,"text":"regex问题\n(两道都是 hard )","expandState":"expand"},"children":[{"data":{"id":"ccmz3goquyw0","created":1625