{"root":{"data":{"id":"f5f4a926e9fc","created":1540457129,"text":"MySQL","expandState":"expand"},"children":[{"data":{"id":"bpc23bc8uadc","created":1540467324743,"text":"服务器安装与管理","expandState":"expand"},"children":[{"data":{"id":"bpc27a0ftrls","created":1540467635309,"text":"安装","expandState":"expand"},"children":[{"data":{"id":"bpc27deqwp34","created":1540467642705,"text":"sudo apt-get install mysql-server\nsudo apt-get install mysql-client\nsudo apt-get install libmysqlclient-dev","expandState":"expand"},"children":[]}]},{"data":{"id":"bpc26ymh2800","created":1540467610520,"text":"服务管理","expandState":"expand"},"children":[{"data":{"id":"bpc281bn229s","created":1540467694760,"text":"查看服务是否开启ps aux | grep mysql","expandState":"expand"},"children":[]},{"data":{"id":"bpc27tmd7vnk","created":1540467677994,"text":"启动服务 sudo service mysql start\n停止服务sudo service mysql stop\n重新启动服务sudo service mysql restart\n查看服务状态 sudo service mysql status","expandState":"expand"},"children":[]}]}]},{"data":{"id":"bpc23xf91tds","created":1540467372814,"text":"数据库操作","expandState":"expand"},"children":[{"data":{"id":"bpc2a2fbxvr4","created":1540467853888,"text":"数据库的CRUD","expandState":"expand"},"children":[{"data":{"id":"bpc28hq07pj4","created":1540467730457,"text":"1 创建数据库\ncreate database 数据库名  create database testdb;\ncreate database 数据库名 character set utf8  create database testdb2 character set utf8;\n2 显示数据库创建信息 show create database 数据库名  show create database testdb;\n3 修改数据库编码 \nalter database 数据库名 character set utf8  \nalter database testdb charset=utf8;\n4 显示所有数据库  show databases;\n5 切换、使用数据库 use 数据库名  use testdb\n6 显示当前数据库 select database(); \n7 删除数据库 drop database 数据库名  drop database testdb2;","expandState":"expand"},"children":[]}]},{"data":{"id":"bpc2abrav5kw","created":1540467874204,"text":"数据库的导入/导出","expandState":"expand"},"children":[{"data":{"id":"bpc2bp4k0jr4","created":1540467981667,"text":"导出整个数据库  mysqldump -uroot -p School > school_bak.sql","expandState":"expand"},"children":[]},{"data":{"id":"bpc2aoodqebk","created":1540467902325,"text":"导出库当中的指定表   mysqldump -uroot -p School tpk > tpk.sql   导出库中单表\n  mysqldump -uroot -p School tpk tfk > tpktfk.sql   导出库中多表","expandState":"expand"},"children":[]},{"data":{"id":"bpc2btnrfda8","created":1540467991535,"text":"导入数据库，导入数据库前需要先创建一个空数据库  语法：mysql -uroot -p 数据库名 < 要导入的文件.sql","expandState":"expand"},"children":[]}]}]},{"data":{"id":"bpc248ud3qww","created":1540467397673,"text":"数据表操作","expandState":"expand"},"children":[{"data":{"id":"bpc28x58ups0","created":1540467764030,"text":"查看表 作用：查看所选数据库中所有的表 语法: show tables\n创建表 作用：在数据库中创建一张新表 语法： create table 表名\n显示创建表信息 作用：用来显示创建表时的信息 语法：show create table 表名; （后面 \\G 不加分号，可以格式化以条目形式显示表）\n增加字段 作用：为已存在的表添加一个新字段 语法：alter table 表名 add 列名 数据类型\n删除字段 作用：在表中删除一个已存在的字段 语法：alter table 表名 drop 列名\n修改字段的数据类型 作用：修改表中现有字段的类型 语法：alter table 表名 modify 字段名 数据类型\n修改列的数据类型并且改名 作用：修改表中现有字段的字段名和类型 语法：alter table 表名 change 原字段名 新字段名 数据类型","expandState":"expand"},"children":[]}]},{"data":{"id":"bpc2ctrfiups","created":1540468070121,"text":"数据的约束","expandState":"expand"},"children":[{"data":{"id":"bpc2etoxgydc","created":1540468226698,"text":"1 主键约束 作用：让数据具有唯一标识，一个表中只能有一个主键字段语法：primary key\ncreate table tpk(id int primary key , name char(10));\n字段被设置了主键约束，同时也具有了唯一性约束和非空约束。 在字段中插入重复数据时，或不给数据时会报错。","expandState":"expand"},"children":[]},{"data":{"id":"bpc2f74iiy2o","created":1540468255939,"text":"2 自动增长 作用：让数字值自动累加 语法：auto_increment 自动增长设置在数值型字段上，需要配合主键约束一起使用。 \n如果字段没有设置主键约束，是不允许设置自动增长的。insert时相应字段序号用0可以实现数据插入时自动增长。\ncreate table tai(id int auto_increment primary key,name varchar(10));","expandState":"expand"},"children":[]},{"data":{"id":"bpc2fdn39uyo","created":1540468270123,"text":"3 唯一性约束 作用：保证数据的准确性，不会出现重复数据 语法：unique\ncreate table tuni(id int unique,name char(10)）；\n一个表中可以给多个字段设置唯一性，如果有需要的话。","expandState":"expand"},"children":[]},{"data":{"id":"bpc2fkn2z3sw","created":1540468285360,"text":"4 非空约束 作用：不允许字段为空，添加数据时必须给值 语法：not null\ncreate table tnn(id int,name char(10) not null);","expandState":"expand"},"children":[]},{"data":{"id":"bpc2fo07e8zk","created":1540468292684,"text":"5 默认约束 作用：在添加数据时，如果没有给定有默认约束字段的数据，该字段使用默认值填充 语法：default\ncreate table tdt(id int,name char(10) default 'NoName');","expandState":"expand"},"children":[]},{"data":{"id":"bpc2frevjqps","created":1540468300101,"text":"6 外键约束 ","expandState":"expand"},"children":[{"data":{"id":"bpc2g0x80kcg","created":1540468320801,"text":"作用：让两表之间产生联动关系 语法：foreign key(字段名) references 表名(字段名)\n-- 表1 \ncreate table fClass(id int primary key,name char(10));\n-- 表2\ncreate table fStudent(id int primary key auto_increment, name char(10), cid int, foreign key(cid) references fClass(id));\n设置外键约束字段所关联的字段，必须是主键约束字段；外键关联的字段类型必须相同。\n想要删除有设置外键的表，必须先删除外键所关联的表。（先删除所有引用的数据表，才能删除被引用的总表）\n* drop table fStudent;\n  drop table fClass;","expandState":"expand"},"children":[]}]},{"data":{"id":"bpc2ealnfw8w","created":1540468185141,"text":"7 检查约束(在MySQL中无效，不起作用) 作用：设置字段的域范围，也就是有效值范围 语法：check(值范围条件)\ncreate table tchk(id int,age int check(age > 0 and age < 150),gender char(10) check('boy' or 'girl'));","layout_right_offset":{"x":10,"y":9},"expandState":"expand"},"children":[]},{"data":{"id":"bpcii9fczmrk","created":1540513633799,"text":"增加删除约束","expandState":"expand"},"children":[{"data":{"id":"bpc2dhvbfe9s","created":1540468122599,"text":"增加删除约束  添加约束前应该保证该字段上没有新添加的约束，删除约束前应该保证该字段上有这个约束。主键列不允许空值，主键可以被其他字段作外键引用。\n外键约束主要用来维护两个表之间数据的一致性。简言之，表的外键就是另一表的主键","expandState":"expand"},"children":[]},{"data":{"id":"bpc2cwln4s8w","created":1540468076301,"text":"添加主键约束 语法：alter table 表名 add constraint 约束名 primary key(字段名)\n删除主键约束 因为一个表中最多只能有一个主键约束，所以可以直接删除 语法：alter table 表名 drop primary key\n添加外键约束 语法：alter table 表名 add constraint 外键约束名 foreign key(外键字段名) references 关联表(关联字段名)。\n删除外键约束 语法：alter table 表名 drop foreign key 外键名","expandState":"expand"},"children":[]}]}]},{"data":{"id":"bpc24bcha7ls","created":1540467403122,"text":"数据的增删改","expandState":"expand"},"children":[{"data":{"id":"bpc2gx0ehq0w","created":1540468390651,"text":"查询数据","expandState":"expand"},"children":[]},{"data":{"id":"bpc2hu979xj4","created":1540468463017,"text":"增加数据","expandState":"expand"},"children":[{"data":{"id":"bpc2jltkdfk0","created":1540468601385,"text":"插入所有字段数据\n可以不指定插入的字段，直接写入插入的数据\n  insert into tStudent values(1,'tom',20)\n插入指定字段\n可以插入指定的字段，指定字段顺序和列中顺序可以不同，值顺序要和指定的列顺序相同。\n  insert into stu(sage,sname) values(20,'jack');\n插入多条数据\n  insert into stu values(2,'rose',20),(3,'tony',22);","expandState":"expand"},"children":[]}]},{"data":{"id":"bpc2iadjp79c","created":1540468498108,"text":"修改数据","expandState":"expand"},"children":[{"data":{"id":"bpc2intpfaio","created":1540468527383,"text":"更新所有的数据\n  update stu set sAge=25;\n更新满足条件的数据\n  update stu set sname='alice' where sname='tony'; ","expandState":"expand"},"children":[]}]},{"data":{"id":"bpc2ich2kcn4","created":1540468502674,"text":"删除数据","expandState":"expand"},"children":[{"data":{"id":"bpc2ivct5lhc","created":1540468543776,"text":"语法1：truncate 表名\n语法2：delete from 表名 [条件]\n删除全部数据 truncate\n  truncate stu;\n不需要加条件，也不能加条件，删除全部数据，重置自动编号到默认值，没有事务，速度快。 —— 不经事务，删除不可恢复 \n  delete from stu;\n相当于 truncate stu,但是delete操作有事务操作，所以速度慢，而且不会重置自动编号。\n —— 可以用在事务操作中，在事务中没有提交时，可撤消。\n删除满足条件的数据\n  delete from stu where snumber = 1;","layout_right_offset":{"x":0,"y":-1},"expandState":"expand"},"children":[]}]}]},{"data":{"id":"bpbyhfiqxekg","created":1540457146502,"text":"数据查询","expandState":"expand"},"children":[{"data":{"id":"bpbyhl6durcw","created":1540457158816,"text":"单表查询","expandState":"expand"},"children":[{"data":{"id":"bpbyi17dwi68","created":1540457193705,"text":"查询所有数据","expandState":"expand"},"children":[{"data":{"id":"bpbyi8wztk3k","created":1540457210491,"text":"select * from 表名"},"children":[]}]},{"data":{"id":"bpbyiej1ahvk","created":1540457222707,"text":"查询指定字段","expandState":"expand"},"children":[{"data":{"id":"bpbyijo1nocg","created":1540457233894,"text":"select 字段1，字段2，... from 表名"},"children":[]}]},{"data":{"id":"bpbyinzmnp4w","created":1540457243302,"text":"as别名","expandState":"expand"},"children":[{"data":{"id":"bpbyivwxjlds","created":1540457260553,"text":"select 字段1 as 别名，字段2 别名，... from 表名"},"children":[]}]},{"data":{"id":"bpbyj0dzu8e8","created":1540457270292,"text":"消除重复数据","expandState":"expand"},"children":[{"data":{"id":"bpbyj6mwkoow","created":1540457283891,"text":"select distinct 字段名 from 表名"},"children":[]}]},{"data":{"id":"bpbyjczqsutc","created":1540457297728,"text":"带条件查询:where","expandState":"expand"},"children":[{"data":{"id":"bpbyjh085bsw","created":1540457306464,"text":"select...from...where..."},"children":[]},{"data":{"id":"bpbyjz2kwlj4","created":1540457345789,"text":"where运算符","expandState":"collapse"},"children":[{"data":{"id":"bpbyk5da8nwg","created":1540457359497,"text":"比较运算符"},"children":[{"data":{"id":"bpbyk96ftfcw","created":1540457367790,"text":"等于: =\n大于: >\n大于等于: >=\n小于: <\n小于等于: <=\n不等于: != 或 <>"},"children":[]}]},{"data":{"id":"bpbykenkw8ow","created":1540457379710,"text":"逻辑运算符"},"children":[{"data":{"id":"bpbykligyzgg","created":1540457394639,"text":"and\nor\nnot"},"children":[]}]},{"data":{"id":"bpbykqypb8jk","created":1540457406504,"text":"模糊查询"},"children":[{"data":{"id":"bpbykuhvxyww","created":1540457414195,"text":"like \n% 表示任意多个任意字符（0-任意个）\n_ 表示一个任意字符"},"children":[]}]},{"data":{"id":"bpbylcdi95a8","created":1540457453112,"text":"范围查询"},"children":[{"data":{"id":"bpbyliycpfk0","created":1540457467433,"text":"in 表示在一个非连续的范围内 , 可以使用 or 实现\nbetween ... and ... 表示在一个连续的范围内，可以使用 and 实现"},"children":[]}]},{"data":{"id":"bpbylnutpiio","created":1540457478104,"text":"空判断"},"children":[{"data":{"id":"bpbymdo9hog0","created":1540457534303,"text":"判断空值 语法：is null\n判断非空值 语法：is not null"},"children":[]}]}]}]},{"data":{"id":"bpbymmqo2vpc","created":1540457554040,"text":"查询结果排序","expandState":"expand"},"children":[{"data":{"id":"bpbymw2dmj9c","created":1540457574339,"text":"单字段排序","expandState":"collapse"},"children":[{"data":{"id":"bpbyn3zxlyww","created":1540457591605,"text":"select * from t_table order by c_age asc;"},"children":[]}]},{"data":{"id":"bpbyw7tajv28","created":1540458305188,"text":"多字段排序","expandState":"collapse"},"children":[{"data":{"id":"bpbywfn8cnpc","created":1540458322236,"text":"select * from t_student order by c_age desc,c_id asc;"},"children":[]}]}]},{"data":{"id":"bpbywk8y1b7k","created":1540458332256,"text":"分页查询","expandState":"expand"},"children":[{"data":{"id":"bpbywugr74e8","created":1540458354496,"text":"select from 表名 limit start=0,count"},"children":[]},{"data":{"id":"bpbyx2y9ophc","created":1540458372969,"text":"查询第 N 页 M 条数据，可以通过公式算出：(N - 1) * M"},"children":[]}]},{"data":{"id":"bpbyx631insw","created":1540458379788,"text":"聚合函数","expandState":"expand"},"children":[{"data":{"id":"bpbyxf6lo9a8","created":1540458399595,"text":"sum 求和函数","expandState":"collapse"},"children":[{"data":{"id":"bpbyxjfm7vnk","created":1540458408847,"text":"select sum(c_age) from t_student;"},"children":[]}]},{"data":{"id":"bpbyxnd543cw","created":1540458417404,"text":"avg 求平均值函数","expandState":"collapse"},"children":[{"data":{"id":"bpbyxqti9e68","created":1540458424924,"text":"select avg(c_age) from t_student;"},"children":[]}]},{"data":{"id":"bpbyxw4fklq8","created":1540458436469,"text":"max 求最大值函数","expandState":"collapse"},"children":[{"data":{"id":"bpbyxzqcbncw","created":1540458444324,"text":"select max(c_age) from t_student where c_gender = '男';"},"children":[]}]},{"data":{"id":"bpbyy3svxo8w","created":1540458453185,"text":"min 求最小值函数","expandState":"collapse"},"children":[{"data":{"id":"bpbyyehfvpq8","created":1540458476437,"text":"select min(c_age) from t_student where c_gender = '女';"},"children":[]}]},{"data":{"id":"bpbyyh8nyoe8","created":1540458482437,"text":"count 统计记录数目","expandState":"collapse"},"children":[{"data":{"id":"bpbyym3oxurk","created":1540458493020,"text":"select count(*) from t_student;\nselect count(*) from t_student where c_gender = '女';"},"children":[]}]}]},{"data":{"id":"bpbyyqgx65fk","created":1540458502527,"text":"分组group","expandState":"expand"},"children":[{"data":{"id":"bpbz2yti8c1s","created":1540458834159,"text":"含义：将相同数据放到一起进行处理","expandState":"expand"},"children":[{"data":{"id":"bpbz30guovls","created":1540458837748,"text":"select分组的字段名,聚合函数... from表名group by分组字段名having分组后的条件"},"children":[]}]},{"data":{"id":"bpbz3duq2q68","created":1540458866885,"text":"单字段分组","expandState":"collapse"},"children":[{"data":{"id":"bpbz3hzrk2kg","created":1540458875897,"text":"select c_gender from t_student group by c_gender;"},"children":[]}]},{"data":{"id":"bpbz3xib5gcg","created":1540458909670,"text":"多字段分组","expandState":"collapse"},"children":[{"data":{"id":"bpbz41pk8idc","created":1540458918815,"text":"多字段只有对应字段完全相同，才能分为同一组"},"children":[]},{"data":{"id":"bpbz49kp13pc","created":1540458935935,"text":"select c_gender, c_address from t_student group by c_gender, c_address;"},"children":[]}]},{"data":{"id":"bpbz4s74660w","created":1540458976473,"text":"group_concat()","expandState":"collapse"},"children":[{"data":{"id":"bpbz543ubaio","created":1540459002396,"text":"select c_gender, group_concat(c_name) from t_student group by c_gender;"},"children":[]}]},{"data":{"id":"bpbz5am0npxc","created":1540459016556,"text":"分组和聚合函数使用","expandState":"collapse"},"children":[{"data":{"id":"bpbz5e54vd34","created":1540459024242,"text":" select c_gender, max(c_age), min(c_age), sum(c_age), avg(c_age), count(*) from t_student group by c_gender;\nselect c_gender, max(c_age), min(c_age), sum(c_age), avg(c_age), count(c_age) from t_student groupby c_gender;"},"children":[]}]},{"data":{"id":"bpbz628chyww","created":1540459076679,"text":"having条件子句 ","expandState":"collapse"},"children":[{"data":{"id":"bpbz65b3hp1c","created":1540459083376,"text":"select c_gender, group_concat(c_name) from t_student group by c_gender having c_gender ='女';\nselect c_gender, group_concat(c_name) from t_student where c_age >50 group by c_gender having c_gender ='女';"},"children":[]}]}]}]},{"data":{"id":"bpbz6zbcuw3k","created":1540459148695,"text":"多表查询","expandState":"expand"},"children":[{"data":{"id":"bpbz79dvi6tc","created":1540459170615,"text":"普通多表查询（无意义）","expandState":"expand"},"children":[{"data":{"id":"bpbz7msxketc","created":1540459199824,"text":"select 表名.字段 ... from 表名1，表名2..."},"children":[]},{"data":{"id":"bpbz8lfhjkzk","created":1540459275198,"text":"查询的结果为M * N条，实际就是笛卡尔积结果"},"children":[]}]},{"data":{"id":"bpc3d1gquzgg","created":1540470907999,"text":"多表查询设置连接条件","expandState":"expand"},"children":[{"data":{"id":"bpc3ddajyku8","created":1540470933746,"text":"在多表个表进行查询时，表与表之间应该是有有关系的，一般会以外键的形式来建立表间的关系"},"children":[]},{"data":{"id":"bpbz8aup4tmo","created":1540459252173,"text":"连接条件e.g.","expandState":"collapse"},"children":[{"data":{"id":"bpbz82gu6dc0","created":1540459233921,"text":"select t_student.c_name,t_class.c_name fromt_student,t_classwheret_student.c_class_id = t_class.c_id;"},"children":[]}]}]},{"data":{"id":"bpbz8q5yj3eo","created":1540459285506,"text":"表别名","expandState":"expand"},"children":[{"data":{"id":"bpbz8uimp9ts","created":1540459294979,"text":"select别名.字段名... from表1 as表1别名，表2表2别名... [条件]"},"children":[]}]},{"data":{"id":"bpbz8yxg9b0g","created":1540459304583,"text":"内连接查询","expandState":"expand"},"children":[{"data":{"id":"bpbz92wsu48w","created":1540459313251,"text":"select * from 表1 inner join 表2 on 表1.列 运算符 表2.列"},"children":[]},{"data":{"id":"bpbz9s0hqd4w","created":1540459367893,"text":"交集"},"children":[]}]},{"data":{"id":"bpbza5y2y60w","created":1540459398222,"text":"左连接查询","expandState":"expand"},"children":[{"data":{"id":"bpbzadde1xq8","created":1540459414386,"text":"select * from表1 left join表2 on表1.列 运算符 表2.列"},"children":[]},{"data":{"id":"bpbzafao1zpc","created":1540459418575,"text":"左集合","expandState":"collapse"},"children":[{"data":{"id":"bpbze9wl3n5s","created":1540459720296,"text":"对应左表查找右表，保证左表的数据显示并查找其在右表的对应关系"},"children":[]}]}]},{"data":{"id":"bpbzasjd3ls0","created":1540459447399,"text":"右连接查询","expandState":"expand"},"children":[{"data":{"id":"bpbzazzrvksg","created":1540459463628,"text":"select * from表1 right join表2 on表1.列 运算符 表2.列"},"children":[]},{"data":{"id":"bpbzdss08pog","created":1540459683014,"text":"右集合","expandState":"collapse"},"children":[{"data":{"id":"bpbzetmmg3k0","created":1540459763229,"text":"对应右表查找左表，保证右边的字段数据显示，并查询其在左表有无对应关系"},"children":[]}]}]},{"data":{"id":"bpbzfafstgcg","created":1540459799822,"text":"子查询","expandState":"expand"},"children":[{"data":{"id":"bpbzffz6japs","created":1540459811878,"text":"标量子查询","expandState":"expand"},"children":[{"data":{"id":"bpbzfrf2tnuo","created":1540459836783,"text":"子查询返回的结果是一个数据(一行一列)"},"children":[]},{"data":{"id":"bpbzs8q3pq0w","created":1540460814825,"text":"主查询 where 条件 比较运算符 (列子查询)"},"children":[]}]},{"data":{"id":"bpbzg2qqw16o","created":1540459861434,"text":"列级子查询","expandState":"expand"},"children":[{"data":{"id":"bpbzref1b18g","created":1540460748853,"text":"子查询返回的结果是一列(一列多行)"},"children":[]},{"data":{"id":"bpbzsi67m8zk","created":1540460835390,"text":"主查询 where 条件 in  (列子查询)"},"children":[]}]},{"data":{"id":"bpbzg6fxnocg","created":1540459869487,"text":"行级子查询","expandState":"expand"},"children":[{"data":{"id":"bpbzro7pyxa8","created":1540460770178,"text":"子查询返回的结果是一行(一行多列) ，一般是有多个条件"},"children":[]},{"data":{"id":"bpbzsqydmqyo","created":1540460854508,"text":"主查询 where (字段1,2,...) = (行子查询)"},"children":[]}]}]},{"data":{"id":"bpbztuc96by8","created":1540460940241,"text":"自连接查询","expandState":"expand"},"children":[{"data":{"id":"bpbzv4kty680","created":1540461040892,"text":"不同类型的数据保存到了同一张表"},"children":[]},{"data":{"id":"bpbzv7cbxslc","created":1540461046908,"text":"查询数据时，连接的多个表实际是同一张表，但是在表中取的数据是不同类型的数据"},"children":[]}]}]}]}]},"template":"right","theme":"fresh-blue-compat","version":"1.4.43"}