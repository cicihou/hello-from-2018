xpandState":"expand"},"children":[{"data":{"id":"bp5b9mc54q9s","created":1539782289159,"text":"邮箱提示未注册，攻击者可以用来确认账号是否存在"},"children":[]}]},{"data":{"id":"bp5b9bluct8g","created":1539782265801,"text":"数据库系统抛出错误信息","expandState":"expand"},"children":[{"data":{"id":"bp5bafa7tczk","created":1539782352170,"text":"详细的错误消息，给攻击者带来灵感"},"children":[]}]}]},{"data":{"id":"bp5bb1kvwpa8","created":1539782400704,"text":"开放重定向Open Redirect","expandState":"expand"},"children":[{"data":{"id":"bp5bbbqes45c","created":1539782422806,"text":"对指定的任意URL作重定向跳转，可能会被定向到恶意Web网站"},"children":[]}]}]},{"data":{"id":"bp5bbrnfgtmo","created":1539782457454,"text":"会话管理疏忽","expandState":"expand"},"children":[{"data":{"id":"bp5bc5f4wfls","created":1539782487427,"text":"会话劫持Session Hijack","expandState":"expand"},"children":[{"data":{"id":"bp5bc8tfo3cw","created":1539782494822,"text":"攻击者拿到用户的会话ID，伪装成用户进行会话"},"children":[]},{"data":{"id":"bp5bcswle70g","created":1539782538549,"text":"获取会话ID途径","expandState":"collapse"},"children":[{"data":{"id":"bp5bd0uwb08w","created":1539782555861,"text":"非正规生成方法推测会话ID"},"children":[]},{"data":{"id":"bp5bd5vx6xvk","created":1539782566807,"text":"窃听或XSS攻击盗取会话ID"},"children":[]},{"data":{"id":"bp5bdd5h6sjk","created":1539782582622,"text":"通过会话固定攻击强行获取"},"children":[]}]}]},{"data":{"id":"bp5bdlvhb94w","created":1539782601608,"text":"会话固定攻击Session Fixation","expandState":"expand"},"children":[{"data":{"id":"bp5be8m9s2kg","created":1539782651118,"text":"攻击者利用用户身份"},"children":[]}]},{"data":{"id":"bp5bee039zi8","created":1539782662837,"text":"跨站点请求伪造 Cross-Site Request Forgeries,CSRF","expandState":"expand"},"children":[]}]},{"data":{"id":"bp5bevz6syyo","created":1539782701965,"text":"其他","expandState":"expand"},"children":[{"data":{"id":"bp5bf0rhuku8","created":1539782712383,"text":"密码破解 Password Cracking","expandState":"expand"},"children":[{"data":{"id":"bp5bf6rf124g","created":1539782725439,"text":"密码试错：穷举法Brute-force Attack；字典攻击 e.g. 撞库"},"children":[]},{"data":{"id":"