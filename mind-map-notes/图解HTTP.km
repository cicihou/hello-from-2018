rent Negotiation","expandState":"expand"},"children":[{"data":{"id":"bp56hlsd179c","created":1539768809327,"text":"服务器+客户端","expandState":"expand"},"children":[]}]}]}]}]},{"data":{"id":"bp56hqby124g","created":1539768819218,"text":"HTTP状态码返回","expandState":"expand"},"children":[{"data":{"id":"bp56i2v9m4n4","created":1539768846509,"text":"状态码表示请求结果","expandState":"expand"},"children":[]},{"data":{"id":"bp56ih884uf4","created":1539768877766,"text":"1XX Informational 信息性状态码 接收的请求正在处理","expandState":"expand"},"children":[]},{"data":{"id":"bp56iwkgipds","created":1539768911158,"text":"2XX Success 成功状态码 请求正常处理完毕","expandState":"expand"},"children":[{"data":{"id":"bp56k7yawzy8","created":1539769014304,"text":"200 OK","expandState":"expand"},"children":[]},{"data":{"id":"bp56kbfpgqv4","created":1539769021887,"text":"204 No Content 请求处理成功，但没有资源可返回","expandState":"expand"},"children":[]},{"data":{"id":"bp56ksiog9a8","created":1539769059071,"text":"206 Partial Content 成功执行GET请求，但响应报文中Content-Range指定范围","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56j71havb4","created":1539768933955,"text":"3XX Redirection 重定向状态码 需要进行附加操作以完成请求","expandState":"expand"},"children":[{"data":{"id":"bp56la0lat4w","created":1539769097160,"text":"301 Moved Permanently 永久性重定向，请求的资源已被分配新的URI","expandState":"expand"},"children":[]},{"data":{"id":"bp56lrf8dyww","created":1539769135050,"text":"302 Found 临时性重定向 ","expandState":"expand"},"children":[]},{"data":{"id":"bp56m6j429ds","created":1539769167937,"text":"303 See Other","expandState":"expand"},"children":[]},{"data":{"id":"bp56md8xld6o","created":1539769182559,"text":"304 Not Modified","expandState":"expand"},"children":[]},{"data":{"id":"bp56mjtov6rk","created":1539769196875,"text":"307 Temporary Redirect","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56jjdza41s","created":1539768960832,"text":"4XX Client Error 客户端错误状态码 服务器无法完成请求","expandState":"expand"},"children":[{"data":{"id":"bp56mqyzm1a8","created":1539769212432,"text":"400 Bad Request","expandState":"expand"},"children":[]},{"data":{"id":"bp56mxcc73eo","created":1539769226300,"text":"401 Unauthorized","expandState":"expand"},"children":[]},{"data":{"id":"bp56n5neemm8","created":1539769244383,"text":"403 Forbidden ","expandState":"expand"},"children":[]},{"data":{"id":"bp56n9uuuk8w","created":1539769253541,"text":"404 Not Found","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56juw48m4g","created":1539768985873,"text":"5XX Server Error 服务器错误状态码 服务器处理请求出错","expandState":"expand"},"children":[{"data":{"id":"bp56nesuhmv4","created":1539769264304,"text":"500 Internal Server Error","expandState":"expand"},"children":[]},{"data":{"id":"bp56nkkpxxxc","created":1539769276873,"text":"503 Service Unavailable","expandState":"expand"},"children":[]}]}]},{"data":{"id":"bp56nunw4268","created":1539769298833,"text":"Web服务器与HTTP协作","expandState":"expand"},"children":[{"data":{"id":"bp56o8ro3ta8","created":1539769329536,"text":"单台虚拟主机实现多个域名","expandState":"expand"},"children":[{"data":{"id":"bp56ok149am8","created":1539769354052,"text":"一个HTTP服务器搭建多个Web站点 via 虚拟主机","expandState":"expand"},"children":[]},{"data":{"id":"bp56pemljocg","created":1539769420654,"text":"不同域名使用相同的IP地址，因此必须指定URI","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56pw3gjp4w","created":1539769458679,"text":"通信数据的转发：代理、网关、隧道","expandState":"expand"},"children":[{"data":{"id":"bp56q8almwhs","created":1539769485232,"text":"代理：服务器和客户端的中间人","expandState":"expand"},"children":[{"data":{"id":"bp56rko8yznk","created":1539769590543,"text":"缓存代理Caching Proxy，二次请求数据时返回缓存资源","expandState":"expand"},"children":[]},{"data":{"id":"bp56rkzn45c0","created":1539769591232,"text":"透明代理（Transparent Proxy），不对报文做任何加工；非透明代理","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56qiytr18g","created":1539769508465,"text":"网关：转发其他服务器通信数据的服务器","expandState":"expand"},"children":[{"data":{"id":"bp56ssu6mha8","created":1539769686680,"text":"把HTTP请求转为非HTTP协议通信","expandState":"expand"},"children":[]},{"data":{"id":"bp56tq6u6dc0","created":1539769759279,"text":"加密提高通信安全性","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56qtr7gzy8","created":1539769531949,"text":"隧道：在远距离服务器和客户端间进行中转，保持双方通信连接","expandState":"expand"},"children":[{"data":{"id":"bp56u56pyw3k","created":1539769791924,"text":"隧道透明，不解析请求，只做加密，保障远距离传输","expandState":"expand"},"children":[]}]}]},{"data":{"id":"bp56v00osqv4","created":1539769859040,"text":"保存资源的缓存","expandState":"expand"},"children":[{"data":{"id":"bp56v7qd52bk","created":1539769875830,"text":"缓存服务器","expandState":"expand"},"children":[{"data":{"id":"bp56vewmlb0g","created":1539769891446,"text":"保存资源副本","expandState":"expand"},"children":[]},{"data":{"id":"bp56vi1ypkow","created":1539769898299,"text":"避免多次从源服务器转发资源，客户端就近获取资源","expandState":"expand"},"children":[]},{"data":{"id":"bp56vtxxj7y8","created":1539769924176,"text":"源服务器也不必处理多次请求","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56vzwgsykg","created":1539769937148,"text":"缓存有效期","expandState":"expand"},"children":[{"data":{"id":"bp56wt88afpc","created":1539770000986,"text":"资源有效性确认","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56w836bklc","created":1539769954968,"text":"客户端本地缓存","expandState":"expand"},"children":[{"data":{"id":"bp56wn7hk8ow","created":1539769987881,"text":"也需要确认资源有效性","expandState":"expand"},"children":[]}]}]}]},{"data":{"id":"bp56xin4u8zk","created":1539770056307,"text":"HTTP报文首部字段","expandState":"expand"},"children":[{"data":{"id":"bp56xrpazx1c","created":1539770076029,"text":"请求首部字段","expandState":"expand"},"children":[]},{"data":{"id":"bp56xtwzgdfk","created":1539770080847,"text":"响应首部字段","expandState":"expand"},"children":[]},{"data":{"id":"bp56xu4xvy80","created":1539770081328,"text":"实体首部字段","expandState":"expand"},"children":[]},{"data":{"id":"bp56y02lvgu8","created":1539770094248,"text":"Cookie首部字段","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56yh3sxszk","created":1539770131326,"text":"HTTPS","expandState":"expand"},"children":[{"data":{"id":"bp56yqfzwoao","created":1539770151654,"text":"HTTP缺点","expandState":"expand"},"children":[{"data":{"id":"bp56ytoyw2dc","created":1539770158727,"text":"通信明文，不加密，内容可能会被窃听","expandState":"expand"},"children":[{"data":{"id":"bp56zrclg1ds","created":1539770231989,"text":"抓包：packet capture&sniffer","expandState":"expand"},"children":[]},{"data":{"id":"bp5708bnj6kg","created":1539770268938,"text":"SSL加密防止窃听","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56z1eqnq4g","created":1539770175523,"text":"不验证通信方身份，可能遭遇伪装","expandState":"expand"},"children":[{"data":{"id":"bp594ty9g4qo","created":1539776271694,"text":"任何人都可以发起请求，服务器都会响应","expandState":"expand"},"children":[]},{"data":{"id":"bp595hnx2pkw","created":1539776323311,"text":"SSL在通信前先确认证书","expandState":"expand"},"children":[]}]},{"data":{"id":"bp56z8tzwp34","created":1539770191683,"text":"无法证明报文完整性，有可能被篡改","expandState":"expand"},"children":[{"data":{"id":"bp595sul3r40","created":1539776347659,"text":"遭到中间人攻击","expandState":"expand"},"children":[]},{"data":{"id":"bp59hs5h4y68","created":1539777286510,"text":"MD5和SHA-1等散列值校验，数字签名验证","expandState":"expand"},"children":[]}]}]},{"data":{"id":"bp59ia71h3pc","created":1539777325787,"text":"HTTP + 加密 + 认证 + 完整性保护 = HTTPS","expandState":"expand"},"children":[{"data":{"id":"bp59je04gw00","created":1539777412440,"text":"HTTPS（HTTP Secure）","expandState":"expand"},"children":[]},{"data":{"id":"bp59jjfoq48w","created":1539777424265,"text":"HTTPS：HTTP通过SSL和TCP通信","expandState":"expand"},"children":[]},{"data":{"id":"bp59knl4tyio","created":1539777511666,"text":"公开密钥加密（Public-key cryptography）","expandState":"expand"},"children":[{"data":{"id":"bp59m4r2ne9s","created":1539777627394,"text":"共享密钥加密Common key crypto system，困境在于如何安全转交密钥","expandState":"expand"},"children":[]},{"data":{"id":"bp59ms2im0hs","created":1539777678152,"text":"公开密钥加密：私有密钥和公开密钥，发送方使用接收方的公开密钥加密并发送，然后接收方用私有密钥解密","expandState":"expand"},"children":[]},{"data":{"id":"bp59ob1l5rls","created":1539777797819,"text":"HTTP混合加密机制：共享密钥和公开密钥两种模式组合","expandState":"expand"},"children":[]}]},{"data":{"id":"bp59p1aiemm8","created":1539777854955,"text":"公开密钥正确性","expandState":"expand"},"children":[{"data":{"id":"bp59p5wbmwow","created":1539777864981,"text":"第三方机构：数字证书认证机构","expandState":"expand"},"children":[]}]},{"data":{"id":"bp59ppwoq39c","created":1539777908539,"text":"HTTPS的安全通信机制","expandState":"expand"},"children":[{"data":{"id":"bp59qmwb27eo","created":1539777980349,"text":"HTTP通信接口部分用SSL（Secure Socket Layer）和TLS（Transport Layer Security） 协议代替","expandState":"expand"},"children":[]},{"data":{"id":"bp59qu49sf7k","created":1539777996069,"text":"SSL会让速度变慢，HTTPS速度比HTTP慢","expandState":"expand"},"children":[{"data":{"id":"bp59rdaol8u8","created":1539778037815,"text":"通信慢：处理通信量增加，网络负载变慢","expandState":"expand"},"children":[]},{"data":{"id":"bp59rdvgjr40","created":1539778039071,"text":"资源消耗导致处理速度变慢：服务器和客户端的硬件资源（内存、CPU）","expandState":"expand"},"children":[]}]}]}]}]},{"data":{"id":"bp59tcwywxz4","created":1539778193714,"text":"用户身份认证","expandState":"expand"},"children":[{"data":{"id":"bp59tqp3nqbk","created":1539778223713,"text":"认证核对信息","expandState":"expand"},"children":[{"data":{"id":"bp59tz2mg2dc","created":1539778241945,"text":"密码、动态令牌、数字证书、生物认证、IC卡","expandState":"expand"},"children":[]}]},{"data":{"id":"bp59u80fskcg","created":1539778261404,"text":"BASIC认证","expandState":"expand"},"children":[{"data":{"id":"bp59v7tm8ykg","created":1539778339356,"text":"自HTTP/1.0","expandState":"expand"},"children":[]}]},{"data":{"id":"bp59uz3mw6ps","created":1539778320371,"text":"DIGEST认证","expandState":"expand"},"children":[{"data":{"id":"bp59vf9sml8g","created":1539778355572,"text":"HTTP/1.1","expandState":"expand"},"children":[]},{"data":{"id":"bp59v39chjpc","created":1539778329423,"text":"质询/响应","expandState":"expand"},"children":[]}]},{"data":{"id":"bp59vqgv2neo","created":1539778379944,"text":"SSL客户端认证（最通用）","expandState":"expand"},"