xpand"},"children":[]},{"data":{"id":"bp5apht5y7eo","created":1539780712021,"text":"和Web服务器相同进程","expandState":"expand"},"children":[]}]}]},{"data":{"id":"bp5aptgnorgg","created":1539780737386,"text":"数据的格式和语言","expandState":"expand"},"children":[{"data":{"id":"bp5aq04iz1fk","created":1539780751890,"text":"XML","expandState":"expand"},"children":[{"data":{"id":"bp5aqatjbncw","created":1539780775170,"text":"eXtensible Markup Language可扩展标记语言","expandState":"expand"},"children":[]},{"data":{"id":"bp5aqka68h6o","created":1539780795767,"text":"XML和HTML都是从SGML简化而来","expandState":"expand"},"children":[]}]},{"data":{"id":"bp5ar1x7988w","created":1539780834165,"text":"RSS/Atom","expandState":"expand"},"children":[{"data":{"id":"bp5ar98cbim8","created":1539780850076,"text":"发布更新信息，都是发布新闻或博客等更新信息文档格式的总称","expandState":"expand"},"children":[]},{"data":{"id":"bp5aroh3kt8g","created":1539780883258,"text":"都基于XML","expandState":"expand"},"children":[]}]},{"data":{"id":"bp5arvmnhzb4","created":1539780898831,"text":"JSON","expandState":"expand"},"children":[{"data":{"id":"bp5as18olbeo","created":1539780911047,"text":"JavaScript Object Notation轻量级数据标记语言","expandState":"expand"},"children":[]},{"data":{"id":"bp5asm8i9qm8","created":1539780956749,"text":"让数据更轻，读取更轻松","expandState":"expand"},"children":[]}]}]}]},{"data":{"id":"bp5aszwjh88w","created":1539780986500,"text":"Web的攻击技术","expandState":"expand"},"children":[{"data":{"id":"bp5at8a45q0w","created":1539781004735,"text":"HTTP缺乏安全功能，单纯的通用的协议机制","expandState":"expand"},"children":[]},{"data":{"id":"bp5avj72f9xc","created":1539781185224,"text":"攻击模式","expandState":"expand"},"children":[{"data":{"id":"bp5avns96n0g","created":1539781195212,"text":"主动active攻击","expandState":"expand"},"children":[{"data":{"id":"bp5attlh8jcw","created":1539781051135,"text":"客户端请求报文中加载攻击代码，Web应用如有漏洞会被攻击者窃取信息甚至夺取权限","expandState":"expand"},"children":[]},{"data":{"id":"bp5awbrateyo","created":1539781247397,"text":"SQL注入攻击和OS命令注入攻击","expandState":"expand"},"