1uf3sw","created":1539778966767,"text":"非强制压缩，数据压缩格式是自定义的","expandState":"expand"},"children":[]}]},{"data":{"id":"bp5a3kgbsdmo","created":1539778993764,"text":"方案","expandState":"expand"},"children":[{"data":{"id":"bp5a3mlj36yo","created":1539778998432,"text":"Ajax（Asynchronous JavaScript and XML）","expandState":"expand"},"children":[{"data":{"id":"bp5a593oeha8","created":1539779125783,"text":"异步加载，通信数据量减少","expandState":"expand"},"children":[]},{"data":{"id":"bp5a5ggatdds","created":1539779141783,"text":"但为了实时从服务器获取内容，仍会有大量请求产生","expandState":"expand"},"children":[]}]},{"data":{"id":"bp5a5yioawao","created":1539779181109,"text":"Comet","expandState":"expand"},"children":[{"data":{"id":"bp5a63wg1wcg","created":1539779192826,"text":"服务端游内容更新，Comet直接给客户端返回响应，模拟Server Push（本质是延迟应答）","expandState":"expand"},"children":[]},{"data":{"id":"bp5a6o4ms0sg","created":1539779236856,"text":"为实时更新挂起响应，为保留响应，连接的持续时间变长，资源消耗变大","expandState":"expand"},"children":[]}]}]}]},{"data":{"id":"bp5a0qiyssu8","created":1539778771892,"text":"SPDY(SPeeDY))","expandState":"expand"},"children":[{"data":{"id":"bp5a13v85dz4","created":1539778800931,"text":"Google希望解决HTTP性能瓶颈，缩短Web页面的加载时间 ","expandState":"expand"},"children":[]},{"data":{"id":"bp5a82v59q80","created":1539779347299,"text":"以会话层的形式加入控制数据流动，仍采用SSL-HTTP建立通信连接","expandState":"expand"},"children":[]},{"data":{"id":"bp5a8lfv4c1s","created":1539779387733,"text":"优点","expandState":"expand"},"children":[{"data":{"id":"bp5a8sorce0w","created":1539779403509,"text":"多路复用流（一个TCP连接处理多个HTTP请求）","expandState":"expand"},"children":[]},{"data":{"id":"bp5a8p7421hc","created":1539779395911,"text":"赋予请求优先级","expandState":"expand"},"children":[]},{"data":{"id":"bp5a93fd3wu8","created":1539779426885,"text":"压缩HTTP首部","expandState":"expand"},"children":[]},{"data":{"id":"bp5a93qp4z5s","created":1539779427571,"text":"推送功能","expandState":"expand"},"children":[]},{"data":{"id":"bp5a99y5xi4g","created":1539779441083,"text":"服务器提示功能：主动提示客户端请求所需资源，避免客户端发送不必要的请求","expandState":"expand"},"children":[]}]},{"data":{"id":"bp5a9qqqpaf4","created":1539779477639,"text":"缺陷","expandState":"expand"},"children":[{"data":{"id":"bp5a9w7tbw1s","created":1539779489555,"text":"单个域名（IP）的通信多路复用","expandState":"expand"},"children":[]},{"data":{"id":"bp5aa1gqhxc0","created":1539779500982,"text":"Web网站使用多个域名下的资源时表现不佳","expandState":"expand"},"children":[]}]}]},{"data":{"id":"bp5aak4vak8w","created":1539779541620,"text":"WebSocket使用浏览器全双工通信","expandState":"expand"},"children":[{"data":{"id":"bp5ab0amszr4","created":1539779576797,"text":"解决Ajax和Comet里XMLHttpRequest的缺点","expandState":"expand"},"children":[]},{"data":{"id":"bp5abfav0ikg","created":1539779609463,"text":"一个建立在HTTP基础上的专用协议","expandState":"expand"},"children":[]},{"data":{"id":"bp5abrom9gxs","created":1539779636416,"text":"优点","expandState":"expand"},"children":[{"data":{"id":"bp5abunpwcg0","created":1539779642892,"text":"推送功能","expandState":"expand"},"children":[]},{"data":{"id":"bp5abwhjbg8w","created":1539779646872,"text":"减少通信量","expandState":"expand"},"children":[{"data":{"id":"bp5ac3el2pds","created":1539779661931,"text":"HTTP连接建立后，需要一次额外的握手用于更改协议","expandState":"expand"},"children":[]}]}]}]},{"data":{"id":"bp5acq5qa22o","created":1539779711461,"text":"HTTP/2.0","expandState":"expand"},"children":[{"data":{"id":"bp5adaffyjuo","created":1539779755584,"text":"讨论中","expandState":"expand"},"children":[]}]},{"data":{"id":"bp5adoy0ck5c","created":1539779787182,"text":"WebDAV管理Web服务器文件","expandState":"expand"},"children":[{"data":{"id":"bp5adyy99kow","created":1539779808965,"text":"WebDAV（Web-based Distributed Authoring and Versioning）基于万维网的分布式创作和版本控制","expandState":"expand"},"children":[]},{"data":{"id":"bp5aev3b4jk0","created":1539779878927,"text":"扩展了HTTP/1.1","expandState":"expand"},"children":[{"data":{"id":"bp5af4crzcow","created":1539779899091,"text":"扩展概念","expandState":"expand"},"children":[{"data":{"id":"bp5afb78ae4g","created":1539779913996,"text":"集合（Collection）：统一管理多个资源",