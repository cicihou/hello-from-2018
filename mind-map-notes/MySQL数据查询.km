{"root":{"data":{"id":"9ea451651f11","created":1540470981,"text":"MySQL数据查询","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zgw6ww","created":1540470991849,"text":"单表查询","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zglp1c","created":1540470991849,"text":"查询所有数据","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zhof0g","created":1540470991850,"text":"select * from 表名"},"children":[]}]},{"data":{"id":"bpc3e3zhjklc","created":1540470991850,"text":"查询指定字段","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zhlds0","created":1540470991850,"text":"select 字段1，字段2，... from 表名"},"children":[]}]},{"data":{"id":"bpc3e3zi68e8","created":1540470991851,"text":"字段别名as","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zhqigw","created":1540470991851,"text":"select 字段1 as 别名，字段2 别名，... from 表名"},"children":[]}]},{"data":{"id":"bpc3e3zhv7y8","created":1540470991851,"text":"消除重复数据","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zihxxc","created":1540470991852,"text":"select distinct 字段名 from 表名"},"children":[]}]},{"data":{"id":"bpc3e3zigi68","created":1540470991852,"text":"带条件查询:where","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zj3aio","created":1540470991853,"text":"select...from...where..."},"children":[]},{"data":{"id":"bpc3e3zj9o1s","created":1540470991853,"text":"where运算符","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3zjbfuo","created":1540470991853,"text":"比较运算符"},"children":[{"data":{"id":"bpc3e3zk0v0g","created":1540470991854,"text":"等于: =\\n大于: >\\n大于等于: >=\\n小于: <\\n小于等于: <=\\n不等于: != 或 <>"},"children":[]}]},{"data":{"id":"bpc3e3zjkao0","created":1540470991854,"text":"逻辑运算符"},"children":[{"data":{"id":"bpc3e3zkbzsw","created":1540470991855,"text":"and\\nor\\nnot"},"children":[]}]},{"data":{"id":"bpc3e3zl4934","created":1540470991856,"text":"模糊查询"},"children":[{"data":{"id":"bpc3e3zksa9s","created":1540470991856,"text":"like \\n% 表示任意多个任意字符（0-任意个）\\n_ 表示一个任意字符"},"children":[]}]},{"data":{"id":"bpc3e3zlbk74","created":1540470991857,"text":"范围查询"},"children":[{"data":{"id":"bpc3e3zlp0qo","created":1540470991857,"text":"in 表示在一个非连续的范围内 , 可以使用 or 实现\\nbetween ... and ... 表示在一个连续的范围内，可以使用 and 实现"},"children":[]}]},{"data":{"id":"bpc3e3zlt14w","created":1540470991857,"text":"空判断"},"children":[{"data":{"id":"bpc3e3zlffnk","created":1540470991857,"text":"判断空值 语法：is null\\n判断非空值 语法：is not null"},"children":[]}]}]}]},{"data":{"id":"bpc3e3zmbqio","created":1540470991858,"text":"查询结果排序","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zmfj7k","created":1540470991858,"text":"单字段排序","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zmeayo","created":1540470991858,"text":"select * from t_table order by c_age asc;"},"children":[]}]},{"data":{"id":"bpc3e3zm9r7k","created":1540470991858,"text":"多字段排序","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zmqdj4","created":1540470991859,"text":"select * from t_student order by c_age desc,c_id asc;"},"children":[]}]}]},{"data":{"id":"bpc3e3zmx43k","created":1540470991859,"text":"分页查询","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zmkhz4","created":1540470991859,"text":"select from 表名 limit start=0,count"},"children":[]},{"data":{"id":"bpc3e3zmq03k","created":1540470991859,"text":"查询第 N 页 M 条数据，可以通过公式算出：(N - 1) * M"},"children":[]}]},{"data":{"id":"bpc3e3zmmha8","created":1540470991859,"text":"聚合函数","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zncutc","created":1540470991860,"text":"sum 求和函数","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3znm5ts","created":1540470991860,"text":"select sum(c_age) from t_student;"},"children":[]}]},{"data":{"id":"bpc3e3zo3j0g","created":1540470991861,"text":"avg 求平均值函数","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3zo7668","created":1540470991861,"text":"select avg(c_age) from t_student;"},"children":[]}]},{"data":{"id":"bpc3e3zoed4w","created":1540470991862,"text":"max 求最大值函数","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3zoieps","created":1540470991862,"text":"select max(c_age) from t_student where c_gender = '男';"},"children":[]}]},{"data":{"id":"bpc3e3zoh0jk","created":1540470991862,"text":"min 求最小值函数","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3zolw5c","created":1540470991862,"text":"select min(c_age) from t_student where c_gender = '女';"},"children":[]}]},{"data":{"id":"bpc3e3zoyvb4","created":1540470991863,"text":"count 统计记录数目","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3zp7sw0","created":1540470991863,"text":"select count(*) from t_student;\\nselect count(*) from t_student where c_gender = '女';"},"children":[]}]}]},{"data":{"id":"bpc3e3zp6y9s","created":1540470991863,"text":"分组group","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zp8rgg","created":1540470991863,"text":"含义：将相同数据放到一起进行处理","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zpb6dc","created":1540470991863,"text":"select分组的字段名,聚合函数... from表名group by分组字段名having分组后的条件"},"children":[]}]},{"data":{"id":"bpc3e3zptla8","created":1540470991864,"text":"单字段分组","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zq0c8w","created":1540470991864,"text":"select c_gender from t_student group by c_gender;"},"children":[]}]},{"data":{"id":"bpc3e3zptse8","created":1540470991864,"text":"多字段分组","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zpq9kw","created":1540470991864,"text":"多字段只有对应字段完全相同，才能分为同一组"},"children":[]},{"data":{"id":"bpc3e3zqgy68","created":1540470991865,"text":"select c_gender, c_address from t_student group by c_gender, c_address;"},"children":[]}]},{"data":{"id":"bpc3e3zql88w","created":1540470991865,"text":"group_concat()","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zqacqo","created":1540470991865,"text":"select c_gender, group_concat(c_name) from t_student group by c_gender;"},"children":[]}]},{"data":{"id":"bpc3e3zq3x1c","created":1540470991865,"text":"分组和聚合函数使用","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zqbbwg","created":1540470991865,"text":" select c_gender, max(c_age), min(c_age), sum(c_age), avg(c_age), count(*) from t_student group by c_gender;\\nselect c_gender, max(c_age), min(c_age), sum(c_age), avg(c_age), count(c_age) from t_student groupby c_gender;"},"children":[]}]},{"data":{"id":"bpc3e3zqmtxc","created":1540470991865,"text":"having条件子句 ","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zq50cg","created":1540470991865,"text":"select c_gender, group_concat(c_name) from t_student group by c_gender having c_gender ='女';\\nselect c_gender, group_concat(c_name) from t_student where c_age >50 group by c_gender having c_gender ='女';"},"children":[]}]}]}]},{"data":{"id":"bpc3e3zqw5q8","created":1540470991866,"text":"多表查询","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zqt8g0","created":1540470991866,"text":"普通多表查询（无意义）","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zqoa9s","created":1540470991866,"text":"select 表名.字段 ... from 表名1，表名2..."},"children":[]},{"data":{"id":"bpc3e3zr8veo","created":1540470991866,"text":"查询的结果为M * N条，实际就是笛卡尔积结果"},"children":[]}]},{"data":{"id":"bpc3e3zqpq0w","created":1540470991866,"text":"多表查询设置连接条件","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zr914w","created":1540470991866,"text":"在多表个表进行查询时，表与表之间应该是有有关系的，一般会以外键的形式来建立表间的关系"},"children":[]},{"data":{"id":"bpc3e3zqzaio","created":1540470991866,"text":"连接条件e.g.","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3zrmmm8","created":1540470991867,"text":"select t_student.c_name,t_class.c_name fromt_student,t_classwheret_student.c_class_id = t_class.c_id;"},"children":[]}]}]},{"data":{"id":"bpc3e3zrdts0","created":1540470991867,"text":"表别名","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zra70g","created":1540470991867,"text":"select别名.字段名... from表1 as表1别名，表2表2别名... [条件]"},"children":[]}]},{"data":{"id":"bpc3e3zrm29s","created":1540470991867,"text":"内连接查询","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zrbwn4","created":1540470991867,"text":"select * from 表1 inner join 表2 on 表1.列 运算符 表2.列"},"children":[]},{"data":{"id":"bpc3e3zrqhhc","created":1540470991867,"text":"交集"},"children":[]}]},{"data":{"id":"bpc3e3zrv7r4","created":1540470991868,"text":"左连接查询","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zsaa68","created":1540470991868,"text":"select * from表1 left join表2 on表1.列 运算符 表2.列"},"children":[]},{"data":{"id":"bpc3e3zrvh1c","created":1540470991868,"text":"左集合","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3zrzls0","created":1540470991868,"text":"对应左表查找右表，保证左表的数据显示并查找其在右表的对应关系"},"children":[]}]}]},{"data":{"id":"bpc3e3zs5a80","created":1540470991868,"text":"右连接查询","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zsug3k","created":1540470991869,"text":"select * from表1 right join表2 on表1.列 运算符 表2.列"},"children":[]},{"data":{"id":"bpc3e3zsrzsw","created":1540470991869,"text":"右集合","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3zshw5c","created":1540470991869,"text":"对应右表查找左表，保证右边的字段数据显示，并查询其在左表有无对应关系"},"children":[]}]}]},{"data":{"id":"bpc3e3zsxkao","created":1540470991869,"text":"子查询","expandState":"expand"},"children":[{"data":{"id":"bpc3e3ztjrb4","created":1540470991870,"text":"标量子查询","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3ztfa4g","created":1540470991870,"text":"子查询返回的结果是一个数据(一行一列)"},"children":[]},{"data":{"id":"bpc3e3ztk268","created":1540470991870,"text":"主查询 where 条件 比较运算符 (列子查询)"},"children":[]}]},{"data":{"id":"bpc3e3zu3zeo","created":1540470991871,"text":"列级子查询","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3zu36dc","created":1540470991871,"text":"子查询返回的结果是一列(一列多行)"},"children":[]},{"data":{"id":"bpc3e3ztufb4","created":1540470991871,"text":"主查询 where 条件 in  (列子查询)"},"children":[]}]},{"data":{"id":"bpc3e3ztpe68","created":1540470991871,"text":"行级子查询","expandState":"collapse"},"children":[{"data":{"id":"bpc3e3zuqyv4","created":1540470991872,"text":"子查询返回的结果是一行(一行多列) ，一般是有多个条件"},"children":[]},{"data":{"id":"bpc3e3zumayo","created":1540470991872,"text":"主查询 where (字段1,2,...) = (行子查询)"},"children":[]}]}]},{"data":{"id":"bpc3e3zuqxhc","created":1540470991872,"text":"自连接查询","expandState":"expand"},"children":[{"data":{"id":"bpc3e3zulwcg","created":1540470991872,"text":"不同类型的数据保存到了同一张表"},"children":[]},{"data":{"id":"bpc3e3zugetc","created":1540470991872,"text":"查询数据时，连接的多个表实际是同一张表，但是在表中取的数据是不同类型的数据"},"children":[]}]}]}]},"template":"right","theme":"fresh-blue-compat","version":"1.4.43"}