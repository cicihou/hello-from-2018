{"root":{"data":{"id":"74c05daefa30","created":1540210780,"text":"逻辑结构图","expandState":"expand"},"children":[{"data":{"id":"bp9j655pq6tc","created":1540210825379,"text":"标准库Standard Library"},"children":[{"data":{"id":"bp9j655qpm2o","created":1540210825380,"text":"模块帮助"},"children":[{"data":{"id":"bp9j655r3wg0","created":1540210825381,"text":"dir()"},"children":[{"data":{"id":"bp9j655r9la8","created":1540210825381,"text":"returns a list of all module functions"},"children":[]}]},{"data":{"id":"bp9j655rkj5s","created":1540210825382,"text":"help()"},"children":[{"data":{"id":"bp9j655sv18g","created":1540210825384,"text":"returns an extensive manual page created from the module's docstrings"},"children":[]}]}]},{"data":{"id":"bp9j655tl05c","created":1540210825385,"text":"操作系统接口Operating System Interface"},"children":[{"data":{"id":"bp9j655u0p34","created":1540210825386,"text":"import os"},"children":[{"data":{"id":"bp9j655u9y4g","created":1540210825386,"text":"提供了很多与操作系统交互的函数"},"children":[]},{"data":{"id":"bp9j6563t6v4","created":1540210825402,"text":"os.open()"},"children":[{"data":{"id":"bp9j6564fkzk","created":1540210825403,"text":"一定要import os，不然os.open()可能覆盖open()"},"children":[]}]},{"data":{"id":"bp9j6564hybk","created":1540210825404,"text":"os.getcwd()"},"children":[{"data":{"id":"bp9j6565n0n4","created":1540210825405,"text":"Return the current working directory"},"children":[]}]},{"data":{"id":"bp9j6565e4u8","created":1540210825405,"text":"os.chdir(directory)"},"children":[{"data":{"id":"bp9j6565lxc0","created":1540210825405,"text":"Change current working directory"},"children":[]}]},{"data":{"id":"bp9j65667ny8","created":1540210825406,"text":"os.system('mkdir today')"},"children":[{"data":{"id":"bp9j6565t0qo","created":1540210825406,"text":"Run the command mkdir in the system shell"},"children":[]}]}]},{"data":{"id":"bp9j6566bmrk","created":1540210825407,"text":"shutil()"},"children":[{"data":{"id":"bp9j6566kg74","created":1540210825407,"text":"针对日常的文件和目录管理任务"},"children":[]},{"data":{"id":"bp9j65673g1s","created":1540210825408,"text":"shutil.copyfile('data.db', 'archive.db')"},"children":[]},{"data":{"id":"bp9j6566wc8w","created":1540210825408,"text":"shutil.move()"},"children":[]}]}]},{"data":{"id":"bp9j6567ln28","created":1540210825409,"text":"文件通配符File Wildcards"},"children":[{"data":{"id":"bp9j6567z8jk","created":1540210825409,"text":"提供了一个函数用于从目录通配符搜索中生成文件列表"},"children":[]},{"data":{"id":"bp9j6567k6io","created":1540210825409,"text":">>> import glob\\n>>> glob.glob('*.py')\\n['primes.py', 'random.py', 'quote.py']"},"children":[]}]},{"data":{"id":"bp9j6568m874","created":1540210825410,"text":"命令行参数Command Line Arguments\\n错误重定向和程序终止Redirection and Termination"},"children":[{"data":{"id":"bp9j6568ewow","created":1540210825410,"text":"Command Line Arguments"},"children":[{"data":{"id":"bp9j6568i39c","created":1540210825410,"text":"sys.argv接收命令行传入的参数"},"children":[]},{"data":{"id":"bp9j65691hq8","created":1540210825411,"text":"getopt和argparse模块可以处理命令行参数"},"children":[]}]},{"data":{"id":"bp9j6568utxc","created":1540210825411,"text":"Redirection and Termination"},"children":[{"data":{"id":"bp9j6569edq8","created":1540210825412,"text":"redirection"},"children":[{"data":{"id":"bp9j6569t0xs","created":1540210825412,"text":"sys.stdin"},"children":[]},{"data":{"id":"bp9j656adc74","created":1540210825413,"text":"sys.stdout"},"children":[]},{"data":{"id":"bp9j656aesqo","created":1540210825413,"text":"stderr"},"children":[]}]},{"data":{"id":"bp9j656b0wsg","created":1540210825414,"text":"termination"},"children":[{"data":{"id":"bp9j656aqjgg","created":1540210825414,"text":"sys.exit()"},"children":[]}]}]}]},{"data":{"id":"bp9j656b8q9s","created":1540210825415,"text":"正则String Pattern Matching"},"children":[{"data":{"id":"bp9j6n2jbmyo","created":1540210864369,"text":"import re"},"children":[{"data":{"id":"bp9j6rtowa2o","created":1540210874718,"text":"re.findall()"},"children":[]},{"data":{"id":"bp9j6z6rpb0g","created":1540210890746,"text":"re.sub()"},"children":[]}]}]},{"data":{"id":"bp9j769txybk","created":1540210906169,"text":"数学Mathematics","expandState":"collapse"},"children":[{"data":{"id":"bp9j7e41rfuo","created":1540210923233,"text":"math模块为浮点运算提供了对底层C函数库的访问"},"children":[{"data":{"id":"bp9j7sb1xedc","created":1540210954132,"text":">>> math.cos(math.pi / 4.0)\n0.70710678118654757"},"children":[]},{"data":{"id":"bp9j86ogln28","created":1540210985417,"text":">>> math.log(1024, 2)\n10.0\n\n2 ** 10 = 1024"},"children":[]}]},{"data":{"id":"bp9j7k5lscg0","created":1540210936388,"text":"random提供了生成随机数的工具"},"children":[{"data":{"id":"bp9j8wdpe2gw","created":1540211041363,"text":">>> random.choice(['apple', 'pear', 'banana'])\n'apple'"},"children":[]},{"data":{"id":"bp9j9bgtjxmo","created":1540211074204,"text":">>> random.sample(range(100), 10)   # sampling without replacement\n[30, 83, 16, 4, 8, 81, 41, 50, 18, 33]"},"children":[]},{"data":{"id":"bp9j9rvxb1mo","created":1540211109945,"text":">>> random.random()    # random float\n0.17970987693706186"},"children":[]},{"data":{"id":"bp9j9yij0000","created":1540211124373,"text":">>> random.randrange(6)    # random integer chosen from range(6)\n4"},"children":[]}]}]},{"data":{"id":"bp9ja537xaf4","created":1540211138685,"text":"互联网访问Internet Access","expandState":"collapse"},"children":[{"data":{"id":"bp9jaidqhm2o","created":1540211167619,"text":"用于处理从 urls 接收的数据的 urllib.request"},"children":[{"data":{"id":"bp9jb2x0q6tc","created":1540211212320,"text":">>> from urllib.request import urlopen\n>>> for line in urlopen('http://tycho.usno.navy.mil/cgi-bin/timer.pl'):\n...     line = line.decode('utf-8')  # Decoding the binary data to text.\n...     if 'EST' in line or 'EDT' in line:  # look for Eastern Time\n...         print(line)\n\n\n<BR>Nov. 25, 09:43:32 PM EST"},"children":[]}]},{"data":{"id":"bp9jamjum8sg","created":1540211176695,"text":"用于发送电子邮件的 smtplib"},"children":[{"data":{"id":"bp9jaq7rn11c","created":1540211184673,"text":"需要在 localhost 运行一个邮件服务器"},"children":[]},{"data":{"id":"bp9jb9bhmpz4","created":1540211226256,"text":">>> import smtplib\n>>> server = smtplib.SMTP('localhost')\n>>> server.sendmail('soothsayer@example.org', 'jcaesar@example.org',\n... \"\"\"To: jcaesar@example.org\n... From: soothsayer@example.org\n...\n... Beware the Ides of March.\n... \"\"\")\n>>> server.quit()"},"children":[]}]}]},{"data":{"id":"bp9jbn7f29kw","created":1540211256485,"text":"日期和时间Dates and Times","expandState":"collapse"},"children":[{"data":{"id":"bp9jc8mg2rr4","created":1540211303106,"text":"支持日期和时间算法>>> # dates are easily constructed and formatted\n>>> from datetime import date\n>>> now = date.today()\n>>> now\ndatetime.date(2003, 12, 2)"},"children":[]},{"data":{"id":"bp9jccjpk7i8","created":1540211311647,"text":"更有效的处理和格式化输出>>> now.strftime(\"%m-%d-%y. %d %b %Y is a %A on the %d day of %B.\")\n'12-02-03. 02 Dec 2003 is a Tuesday on the 02 day of December.'"},"children":[]},{"data":{"id":"bp9jcg4e6olc","created":1540211319428,"text":">>> now.strftime(\"%m-%d-%y. %d %b %Y is a %A on the %d day of %B.\")\n'12-02-03. 02 Dec 2003 is a Tuesday on the 02 day of December.'"},"children":[]}]},{"data":{"id":"bp9jdn4oexhc","created":1540211413047,"text":"数据压缩Data Compression"},"children":[{"data":{"id":"bp9jdyqfc4cg","created":1540211438307,"text":"以下模块直接支持通用的数据打包和压缩格式：zlib\ngzip\nbz2\nlzma\nzipfile\ntarfile"},"children":[]}]},{"data":{"id":"bp9jel6fn20w","created":1540211487164,"text":"性能度量Performance Measurement"},"children":[{"data":{"id":"bp9jey0ax05c","created":1540211515092,"text":">>> from timeit import Timer\n>>> Timer('t=a; a=b; b=t', 'a=1; b=2').timeit()\n0.57535828626024577\n>>> Timer('a,b = b,a', 'a=1; b=2').timeit()\n0.54962537085770791"},"children":[]},{"data":{"id":"bp9jibrai7ls","created":1540211780114,"text":"相对于 timeit的细粒度，profile和 pstats\n 模块提供了针对更大代码块的时间度量工具"},"children":[]}]},{"data":{"id":"bp9jimn2iyo0","created":1540211803803,"text":"质量控制","expandState":"expand"},"children":[{"data":{"id":"bp9jj09948hs","created":1540211833443,"text":"doctest模块提供了一个工具，扫描模块并根据程序中内嵌的文档字符串执行测试。"},"children":[]},{"data":{"id":"bp9jjg99zlkw","created":1540211868273,"text":"unittest可以在一个独立的文件里提供一个更全面的测试集"},"children":[]}]}]},{"data":{"id":"bp9jkz71k0e8","created":1540211987861,"text":"标准库（更高级的模块）"},"children":[{"data":{"id":"bp9jlwyr83r4","created":1540212061370,"text":"输出格式Output Formatting"},"children":[{"data":{"id":"bp9jma3i5b7k","created":1540212089956,"text":"reprlib模块为大型的或深度嵌套的容器缩写显示提供了repr()函数的一个定制版本"},"children":[]},{"data":{"id":"bp9jms8pqadc","created":1540212129453,"text":"pprint模块提供了一种解释器可读的方式深入控制内置和用户自定义对象的打印"},"children":[]},{"data":{"id":"bp9jn1nxemtc","created":1540212149964,"text":"textwrap模块格式化文本段落以适应设定的屏宽"},"children":[]},{"data":{"id":"bp9jnaopk1kw","created":1540212169602,"text":"locale模块按访问预定好的国家信息数据库。locale 的格式化函数属性集提供了一个直接方式以分组标示格式化数字"},"children":[]}]},{"data":{"id":"bp9jnyxai1vk","created":1540212222364,"text":"模板"},"children":[{"data":{"id":"bp9jo444k6bk","created":1540212233661,"text":"string提供了一个灵活多变的模版类 Template\n 使用它最终用户可以用简单的进行编辑。这使用户可以在不进行改变的情况下定制他们的应用程序。"},"children":[]}]},{"data":{"id":"bp9jo2thfbb4","created":1540212230841,"text":"使用二进制数据记录布局"},"children":[{"data":{"id":"bp9joez5uolc","created":1540212257305,"text":"struct模块为使用变长的二进制记录格式提供了 pack()和 unpack()函数"},"children":[]}]},{"data":{"id":"bp9jor5q9o1s","created":1540212283824,"text":"多线程 Multi-threading"},"children":[{"data":{"id":"bp9jp6einda8","created":1540212317007,"text":"threading"},"children":[]},{"data":{"id":"bp9jp8rtm6tc","created":1540212322165,"text":"线程通信queue"},"children":[]}]},{"data":{"id":"bp9jpg6564u8","created":1540212338268,"text":"日志Logging"},"children":[{"data":{"id":"bp9jpo2y639c","created":1540212355489,"text":"logging模块提供了完整和灵活的日志系统。它最简单的用法是记录信息并发送到一个文件或 sys.stderr"},"children":[]}]},{"data":{"id":"bp9jq177j2f4","created":1540212384045,"text":"弱引用Weak References"},"children":[{"data":{"id":"bp9jqdwh3ls0","created":1540212411694,"text":" weakref模块提供了不用创建引用的跟踪对象工具，一旦对象不再存在，它自动从弱引用表上删除并触发回调"},"children":[]},{"data":{"id":"bp9jqj8yay9s","created":1540212423333,"text":"典型的应用包括捕获难以构造的对象"},"children":[]}]},{"data":{"id":"bp9jqnep3gu8","created":1540212432387,"text":"列表工具"},"children":[{"data":{"id":"bp9jqymb5i4g","created":1540212456792,"text":"array模块提供了一个类似列表的 array()对象，它仅仅是存储数据，更为紧凑"},"children":[]},{"data":{"id":"bp9jr49uwpog","created":1540212469100,"text":"collections模块提供了类似列表的 deque()对象，它从左边添加（append）和弹出（pop）更快，但是在内部查询更慢。\n这些对象更适用于队列实现和广度优先的树搜索"},"children":[]},{"data":{"id":"bp9jrpsit8n4","created":1540212515941,"text":" bisect这样的模块以操作存储链表"},"children":[]},{"data":{"id":"bp9jrunl13b4","created":1540212526526,"text":"heapq提供了基于正规链表的堆实现。最小的值总是保持在 0 点。\n这在希望循环访问最小元素但是不想执行完整堆排序的时候非常有用"},"children":[]}]},{"data":{"id":"bp9jryul5p1c","created":1540212535657,"text":"十进制浮点数算法Decimal Floating Point Arithmetic"},"children":[{"data":{"id":"bp9jskf6e0ao","created":1540212582614,"text":"decimal模块提供了一个 Decimal\n 数据类型用于浮点数计算"},"children":[]}]}]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}