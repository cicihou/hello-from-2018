{"root":{"data":{"id":"4d9c501b4561","created":1540547423,"text":"数据库编程基本操作方法"},"children":[{"data":{"id":"bpcui1nafp4w","created":1540547470183,"text":"数据库对象","expandState":"expand"},"children":[{"data":{"id":"bpcuig8h4vsw","created":1540547501939,"text":"获取游标\ncursor()"},"children":[]},{"data":{"id":"bpcuj8urjj7k","created":1540547564237,"text":"提交数据 \ncommit()"},"children":[]},{"data":{"id":"bpcujb71x728","created":1540547569333,"text":"撤销操作\nrollback()"},"children":[]},{"data":{"id":"bpcujdpevwn4","created":1540547574797,"text":"关闭连接\nclose()"},"children":[]}]},{"data":{"id":"bpcui4p4sr9c","created":1540547476825,"text":"游标对象","expandState":"expand"},"children":[{"data":{"id":"bpcuikzmg6ps","created":1540547512288,"text":"⁃\t执行SQL语句\nexecute()"},"children":[]},{"data":{"id":"bpcuisphnl6o","created":1540547529089,"text":"获取一条查询 结果 \nfetchone()"},"children":[]},{"data":{"id":"bpcuivpanmdc","created":1540547535608,"text":"获取指定条数查询结果\nfetchmany(n)"},"children":[]},{"data":{"id":"bpcuj1zyt69s","created":1540547549314,"text":"获取所有查询 结果 \nfetchall()"},"children":[]},{"data":{"id":"bpcuj49bhgqo","created":1540547554233,"text":"关闭游标\nclose()"},"children":[]}]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}