{"root":{"data":{"id":"3596f214054e","created":1551153047,"text":"Flask","expandState":"expand"},"children":[{"data":{"id":"bsa7cyjwp2ww","created":1551247541508,"text":"环境"},"children":[]},{"data":{"id":"bsa7w95atfk0","created":1551249053487,"text":"Werkzueg工具集","expandState":"expand"},"children":[{"data":{"id":"bsa7m9r1h5vk","created":1551248271160,"text":"路由routing模块","expandState":"expand"},"children":[{"data":{"id":"bsa81l3bzd34","created":1551249471310,"text":"Rule，Map，BaseConverter，MapAdapter","expandState":"expand"},"children":[]},{"data":{"id":"bsa7mrfs3zeo","created":1551248309661,"text":"参数传递@app.route('URL')，methods参数可指定请求类型"},"children":[]},{"data":{"id":"bsa7p858efi8","created":1551248502757,"text":"正则匹配路由：converter转换器"},"children":[]}]},{"data":{"id":"bsa7s420k1ds","created":1551248728948,"text":"请求request"},"children":[{"data":{"id":"bsa7s7muvdog","created":1551248736739,"text":"request对象获取请求数据"},"children":[]}]},{"data":{"id":"bsa7ujp46i9s","created":1551248919725,"text":"响应response"},"children":[{"data":{"id":"bsa7un9ewh6o","created":1551248927482,"text":"return jsonify返回JSON数据"},"children":[]},{"data":{"id":"bsa7uvautlog","created":1551248944984,"text":"return redirect 重定向到网页，可直接链接，也可url_for()到视图"},"children":[]}]}]},{"data":{"id":"bsa7xzqypnnk","created":1551249189757,"text":"Jinja2模块"},"children":[{"data":{"id":"bsa92g0rx1j4","created":1551252359746,"text":"context上下文"},"children":[]},{"data":{"id":"bsa92jglwyyo","created":1551252367234,"text":"filter过滤器"},"children":[]}]},{"data":{"id":"bsa8mttz9i4g","created":1551251135983,"text":"其它"},"children":[{"data":{"id":"bsa8mdfugglc","created":1551251100300,"text":"请求钩子：类似中间件，对视图前后进行处理"},"children":[]},{"data":{"id":"bsa8n2kh85j4","created":1551251155000,"text":"异常捕获：abort直接抛出状态码，errorhandler处理参数所指定的错误"},"children":[]},{"data":{"id":"bsa8ohajcirk","created":1551251265415,"text":"context上下文"},"children":[{"data":{"id":"bsa8q0ctfaps","created":1551251385275,"text":"请求上下文request context（request，session）；"},"children":[]},{"data":{"id":"bsa8q43ul1q8","created":1551251393440,"text":"应用上下文application context（current_app，g变量）"},"children":[]}]}]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}